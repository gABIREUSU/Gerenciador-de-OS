package view;

import javax.swing.*;

import model.TelaConsultaDAO;

import java.awt.event.*;
import java.util.List;

public class TelaConsulta extends JFrame {

    private JComboBox<String> cbTabelas;
    private JTextField txtFiltro;
    private JTextArea txtResultado;
    private JButton btnBuscar;

    private TelaConsultaDAO dao = new TelaConsultaDAO();

    public TelaConsulta() {
        setTitle("Consulta com Filtros");
        setSize(650, 500);
        setLayout(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        JLabel lblTabela = new JLabel("Tabela:");
        lblTabela.setBounds(20, 20, 50, 25);
        add(lblTabela);

        cbTabelas = new JComboBox<>(new String[]{"Empresas", "Equipamento", "OS"});
        cbTabelas.setBounds(80, 20, 150, 25);
        add(cbTabelas);

        JLabel lblFiltro = new JLabel("Filtro:");
        lblFiltro.setBounds(250, 20, 50, 25);
        add(lblFiltro);

        txtFiltro = new JTextField();
        txtFiltro.setBounds(300, 20, 200, 25);
        add(txtFiltro);

        btnBuscar = new JButton("Buscar");
        btnBuscar.setBounds(520, 20, 100, 25);
        add(btnBuscar);

        txtResultado = new JTextArea();
        txtResultado.setEditable(false);
        JScrollPane scroll = new JScrollPane(txtResultado);
        scroll.setBounds(20, 70, 600, 370);
        add(scroll);

        btnBuscar.addActionListener(e -> buscarDados());
    }

    private void buscarDados() {
        String tabela = cbTabelas.getSelectedItem().toString();
        String filtro = txtFiltro.getText().trim();
        List<String> resultados = null;

        switch (tabela) {
            case "Empresas":
                resultados = dao.consultarEmpresas(filtro);
                break;
            case "Equipamento":
                resultados = dao.consultarEquipamentos(filtro);
                break;
            case "OS":
                resultados = dao.consultarOS(filtro);
                break;
        }

        txtResultado.setText(tabela + " - Resultados:\n\n");
        if (resultados != null && !resultados.isEmpty()) {
            for (String linha : resultados) {
                txtResultado.append(linha + "\n");
            }
        } else {
            txtResultado.append("Nenhum resultado encontrado.");
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new TelaConsulta().setVisible(true));
    }
}
