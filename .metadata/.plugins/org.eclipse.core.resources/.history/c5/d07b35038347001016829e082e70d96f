package view;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;

import model.TelaConsultaDAO;

import java.awt.event.*;
import java.util.*;

public class TelaConsulta extends JFrame {

    private JComboBox<String> cbTabelas;
    private JComboBox<String> cbFiltros;
    private JTextField txtFiltroValor;
    private JTable tabela;
    private DefaultTableModel tableModel;
    private TelaConsultaDAO dao = new TelaConsultaDAO();

    private final Map<String, String[]> filtrosPorTabela = Map.of(
        "Empresas", new String[]{"Todos", "Nome", "CNPJ"},
        "Equipamento", new String[]{"Todos", "Nome_Equip", "Cod_Emp"},
        "OS", new String[]{"Todos", "Data", "Cod_Equip"}
    );

    public TelaConsulta() {
        setTitle("Consulta com Filtros");
        setSize(750, 500);
        setLayout(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        JLabel lblTabela = new JLabel("Tabela:");
        lblTabela.setBounds(20, 20, 50, 25);
        add(lblTabela);

        cbTabelas = new JComboBox<>(filtrosPorTabela.keySet().toArray(new String[0]));
        cbTabelas.setBounds(80, 20, 150, 25);
        add(cbTabelas);

        JLabel lblFiltro = new JLabel("Filtro:");
        lblFiltro.setBounds(250, 20, 50, 25);
        add(lblFiltro);

        cbFiltros = new JComboBox<>();
        cbFiltros.setBounds(300, 20, 150, 25);
        add(cbFiltros);

        txtFiltroValor = new JTextField();
        txtFiltroValor.setBounds(460, 20, 150, 25);
        add(txtFiltroValor);

        JButton btnBuscar = new JButton("Buscar");
        btnBuscar.setBounds(620, 20, 100, 25);
        add(btnBuscar);

        tableModel = new DefaultTableModel();
        tabela = new JTable(tableModel);
        JScrollPane scroll = new JScrollPane(tabela);
        scroll.setBounds(20, 70, 700, 370);
        add(scroll);

        cbTabelas.addActionListener(e -> atualizarFiltros());
        cbFiltros.addActionListener(e -> {
            String filtro = cbFiltros.getSelectedItem().toString();
            txtFiltroValor.setVisible(!filtro.equals("Todos"));
        });

        btnBuscar.addActionListener(e -> buscarDados());

        atualizarFiltros(); // Inicializa os filtros da primeira tabela
    }

    private void atualizarFiltros() {
        String tabela = cbTabelas.getSelectedItem().toString();
        cbFiltros.removeAllItems();
        for (String filtro : filtrosPorTabela.get(tabela)) {
            cbFiltros.addItem(filtro);
        }
        cbFiltros.setSelectedIndex(0);
        txtFiltroValor.setVisible(false);
    }

    private void buscarDados() {
        String tabelaSelecionada = cbTabelas.getSelectedItem().toString();
        String filtro = cbFiltros.getSelectedItem().toString();
        String valor = txtFiltroValor.getText().trim();
        List<Object[]> dados = null;
        String[] colunas;

        switch (tabelaSelecionada) {
            case "Empresas":
                colunas = new String[]{"Cod_Emp", "Nome", "CNPJ", "Endereco", "Telefone"};
                dados = dao.consultarEmpresasFiltro(filtro, valor);
                break;
            case "Equipamento":
                colunas = new String[]{"Cod_Equip", "Cod_Emp", "Nome_Equip"};
                dados = dao.consultarEquipamentosFiltro(filtro, valor);
                break;
            case "OS":
                colunas = new String[]{"Cod_OS", "Cod_Equip", "Data", "Preco"};
                dados = dao.consultarOSFiltro(filtro, valor);
                break;
            default:
                return;
        }

        atualizarTabela(colunas, dados);
    }

    private void atualizarTabela(String[] colunas, List<Object[]> dados) {
        tableModel.setRowCount(0);
        tableModel.setColumnIdentifiers(colunas);
        for (Object[] linha : dados) {
            tableModel.addRow(linha);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new TelaConsulta().setVisible(true));
    }
}
