		RoundButton btnSalvar = new RoundButton("Salvar OS");
		btnSalvar.setBounds(460, 265, 140, 30);
		btnSalvar.setForeground(Color.WHITE);
		btnSalvar.addActionListener(e -> {
			try {
				salvar();
			} catch (SQLException ex) {
				ex.printStackTrace();
			}
		});
		contentPanel.add(btnSalvar);

		JLabel lblPreco = new JLabel("Preço Final:");
		lblPreco.setBounds(473, 317, 100, 20);
		lblPreco.setForeground(Color.WHITE);
		contentPanel.add(lblPreco);

		textField = new DJTextField("  R$" + preco);
		textField.setBounds(470, 342, 120, 25);
		textField.setEditable(false);
		contentPanel.add(textField);
		
		MostrarSeta setaVoltar = new MostrarSeta();
		setaVoltar.setBounds(570, 23, 30, 27); 
		setaVoltar.setBackground(new Color(166, 180, 255)); 
		setaVoltar.addActionListener(e -> {
			new Menu().setVisible(true); 
			dispose(); 
		});
		contentPanel.add(setaVoltar);


		carregarEmpresas();
		setVisible(true);
	}

	private void adicionarItemDinamico(char tipo) throws SQLException {
		JPanel itemPanel = new JPanel();
		itemPanel.setLayout(new BoxLayout(itemPanel, BoxLayout.X_AXIS));
		itemPanel.setMaximumSize(new Dimension(Integer.MAX_VALUE, 35));
		itemPanel.setOpaque(false);

		JComboBox<String> combo = new JComboBox<>();
		combo.setPreferredSize(new Dimension(200, 30));
		combo.setMaximumSize(new Dimension(200, 30));
		combo.setBackground(Color.WHITE);
		combo.setForeground(Color.BLACK);
		combo.setUI(new RoundedComboBoxUI());
		combo.setBorder(BorderFactory.createEmptyBorder(5, 10, 5, 5));
		combo.setRenderer(getCustomRenderer());
		combo.addActionListener(e -> setPreco());

		List<String> itens = controller.carregarItens(tipo);
		for (String item : itens) {
			combo.addItem(item);
		}

		JButton btnRemover = new JButton("Remover");
		btnRemover.addActionListener(e -> {
			setPreco();
			painelItens.remove(itemPanel);
			listaItens.remove(itemPanel);
			painelItens.revalidate();
			painelItens.repaint();
			setPreco();
		});

		itemPanel.add(Box.createRigidArea(new Dimension(5, 0)));
		itemPanel.add(combo);
		itemPanel.add(Box.createRigidArea(new Dimension(10, 0)));
		itemPanel.add(btnRemover);
		itemPanel.add(Box.createHorizontalGlue());

		painelItens.add(itemPanel);
		listaItens.add(itemPanel);
		painelItens.revalidate();
		painelItens.repaint();
		setPreco();
	}

	public void carregarEmpresas() {
		try {
			List<String> empresas = controller.carregarEmpresas();
			for (String emp : empresas) {
				CB_Empresa.addItem(emp);
			}
		} catch (RuntimeException e) {
			JOptionPane.showMessageDialog(this, "Erro ao carregar empresas: " + e.getMessage());
		}
	}

	public void carregarEquipamento(int codEmp) {
		try {
			List<String> equipamentos = controller.carregarEquipamentos(codEmp);
			for (String eq : equipamentos) {
				CB_Equip.addItem(eq);
			}
		} catch (RuntimeException e) {
			JOptionPane.showMessageDialog(this, "Erro ao carregar equipamentos: " + e.getMessage());
		}
	}

	public int getCodEmp(String empresa) {
		return controller.getCodEmp(empresa);
	}

	public void setPreco() {
		List<String> selecionados = getValoresSelecionados();
		preco = controller.setPreco(selecionados);
		textField.setText("  R$" + preco);
	}

	public List<String> getValoresSelecionados() {
		List<String> selecionados = new ArrayList<>();
		for (JPanel panel : listaItens) {
			for (Component comp : panel.getComponents()) {
				if (comp instanceof JComboBox) {
					@SuppressWarnings("unchecked")
					JComboBox<String> combo = (JComboBox<String>) comp;
					String valor = (String) combo.getSelectedItem();
					if (valor != null) {
						selecionados.add(valor);
					}
				}
			}
		}
		return selecionados;
	}

	public void salvar() throws SQLException {
		LocalDate hoje = LocalDate.now();
		String dataFormatada = hoje.format(DateTimeFormatter.ofPattern("dd/MM/yyyy"));
		int cod_equip = controller.getCodEquip((String) CB_Equip.getSelectedItem(), (String) CB_Empresa.getSelectedItem());
		controller.salvar(cod_equip, dataFormatada, preco, getValoresSelecionados());
		JOptionPane.showMessageDialog(this, "Ordem de serviço salva com sucesso!");
	}

	private ListCellRenderer<? super String> getCustomRenderer() {
		return new DefaultListCellRenderer() {
			private static final long serialVersionUID = 1L;

			@Override
			public Component getListCellRendererComponent(JList<?> list, Object value, int index, boolean isSelected, boolean cellHasFocus) {
				JLabel label = (JLabel) super.getListCellRendererComponent(list, value, index, isSelected, cellHasFocus);
				if ("Selecionar empresa".equals(value)) {
					label.setForeground(Color.LIGHT_GRAY);
				} else {
					label.setForeground(Color.BLACK);
				}
				label.setBackground(Color.WHITE);
				label.setOpaque(true);
				label.setBorder(new EmptyBorder(2, 8, 2, 2));
				return label;
			}
		};
	}
}
