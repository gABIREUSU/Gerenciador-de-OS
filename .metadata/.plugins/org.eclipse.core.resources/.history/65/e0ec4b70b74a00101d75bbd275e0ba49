public class AberturaOS extends JFrame {
	private static final long serialVersionUID = 1L;
	private OSController controller = new OSController();
	private List<JPanel> listaItens = new ArrayList<>();
	private JComboBox<String> CB_Empresa;
	private JComboBox<String> CB_Equip;
	private JPanel painelItens;
	private RoundButton btnAdicionarItem;
	private DJTextField textField;
	private float preco;

	public static void main(String[] args) {
		SwingUtilities.invokeLater(AberturaOS::new);
	}

	public AberturaOS() {
		setTitle("Abertura de OS");
		setSize(650, 480);
		setLocationRelativeTo(null);
		setDefaultCloseOperation(EXIT_ON_CLOSE);

		GradientePanel contentPanel = new GradientePanel();
		contentPanel.setLayout(null);
		setContentPane(contentPanel);

		JLabel titulo = new JLabel("ABERTURA DE OS");
		titulo.setFont(new Font("Sitka Small", Font.BOLD, 18));
		titulo.setBounds(240, 20, 200, 30);
		titulo.setForeground(Color.WHITE);
		contentPanel.add(titulo);

		JLabel lblEmpresa = new JLabel("Empresa:");
		lblEmpresa.setBounds(50, 70, 80, 20);
		lblEmpresa.setForeground(Color.WHITE);
		contentPanel.add(lblEmpresa);

		CB_Empresa = new JComboBox<>();
		CB_Empresa.setBounds(130, 70, 460, 30);
		CB_Empresa.setBackground(Color.WHITE);
		CB_Empresa.setForeground(Color.BLACK);
		CB_Empresa.setUI(new RoundedComboBoxUI());
		CB_Empresa.setBorder(BorderFactory.createEmptyBorder(5, 10, 5, 5));
		CB_Empresa.setRenderer(getCustomRenderer());
		CB_Empresa.addActionListener(e -> {
			CB_Equip.removeAllItems();
			carregarEquipamento(getCodEmp((String) CB_Empresa.getSelectedItem()));
		});
		contentPanel.add(CB_Empresa);

		JLabel lblEquip = new JLabel("Equipamento:");
		lblEquip.setBounds(50, 105, 90, 20);
		lblEquip.setForeground(Color.WHITE);
		contentPanel.add(lblEquip);

		CB_Equip = new JComboBox<>();
		CB_Equip.setBounds(130, 105, 460, 30);
		CB_Equip.setBackground(Color.WHITE);
		CB_Equip.setForeground(Color.BLACK);
		CB_Equip.setUI(new RoundedComboBoxUI());
		CB_Equip.setBorder(BorderFactory.createEmptyBorder(5, 10, 5, 5));
		CB_Equip.setRenderer(getCustomRenderer());
		contentPanel.add(CB_Equip);

		RoundedPanel scrollContainer = new RoundedPanel();
		scrollContainer.setBounds(50, 145, 390, 230);
		scrollContainer.setBackgroundColor(Color.WHITE);
		scrollContainer.setLayout(null);
		contentPanel.add(scrollContainer);

		painelItens = new JPanel();
		painelItens.setLayout(new BoxLayout(painelItens, BoxLayout.Y_AXIS));
		painelItens.setOpaque(false);

		JScrollPane scrollPane = new JScrollPane(painelItens);
		scrollPane.setBounds(10, 10, 370, 210);
		scrollPane.setBorder(null);
		scrollPane.setOpaque(false);
		scrollPane.getViewport().setOpaque(false);
		scrollContainer.add(scrollPane);

		btnAdicionarItem = new RoundButton("Adicionar Peça");
		btnAdicionarItem.setBounds(460, 157, 140, 30);
		btnAdicionarItem.setForeground(Color.WHITE);
		btnAdicionarItem.addActionListener(e -> {
			try {
				adicionarItemDinamico('I');
			} catch (SQLException ex) {
				ex.printStackTrace();
			}
		});
		contentPanel.add(btnAdicionarItem);

		RoundButton btnAdicionarServico = new RoundButton("Adicionar Serviço");
		btnAdicionarServico.setBounds(460, 211, 140, 30);
		btnAdicionarServico.setForeground(Color.WHITE);
		btnAdicionarServico.addActionListener(e -> {
			try {
				adicionarItemDinamico('S');
