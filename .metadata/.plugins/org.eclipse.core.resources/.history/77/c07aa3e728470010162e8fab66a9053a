import javax.swing.*;
import javax.swing.table.DefaultTableModel;

import controller.ConsultaGeralController;

import java.awt.*;
import java.awt.event.ActionListener;
import java.util.List;
import java.util.Vector;

public class ConsultaGeral extends JFrame {
    private JPanel contentPane;
    private JTable table;
    private JComboBox<String> comboTabelas;
    private JButton btnBuscar;

    private ConsultaGeralController controller = new ConsultaGeralController();

    public ConsultaGeral() {
        setTitle("Consulta Geral do Banco de Dados");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setBounds(100, 100, 800, 500);
        contentPane = new JPanel();
        contentPane.setBorder(BorderFactory.createEmptyBorder(5, 5, 5, 5));
        setContentPane(contentPane);
        contentPane.setLayout(null);

        JLabel lblTabela = new JLabel("Tabela:");
        lblTabela.setBounds(20, 20, 50, 25);
        contentPane.add(lblTabela);

        comboTabelas = new JComboBox<>();
        comboTabelas.setBounds(80, 20, 200, 25);
        contentPane.add(comboTabelas);

        btnBuscar = new JButton("Buscar");
        btnBuscar.setBounds(300, 20, 100, 25);
        contentPane.add(btnBuscar);

        JScrollPane scrollPane = new JScrollPane();
        scrollPane.setBounds(20, 60, 740, 380);
        contentPane.add(scrollPane);

        table = new JTable();
        scrollPane.setViewportView(table);

        // Preencher as tabelas válidas no comboBox
        List<String> tabelas = controller.getTabelasValidas();
        for (String tabela : tabelas) {
            comboTabelas.addItem(tabela);
        }

        // Ação do botão buscar
        btnBuscar.addActionListener(e -> carregarDados());

        // Carregar automaticamente a primeira
        if (comboTabelas.getItemCount() > 0) {
            comboTabelas.setSelectedIndex(0);
            carregarDados();
        }
    }

    private void carregarDados() {
        String tabelaSelecionada = (String) comboTabelas.getSelectedItem();
        if (tabelaSelecionada != null) {
            Vector<String> colunas = controller.getColunasTabela(tabelaSelecionada);
            Vector<Vector<Object>> dados = controller.getDadosTabela(tabelaSelecionada);
            table.setModel(new DefaultTableModel(dados, colunas));
        }
    }
}
