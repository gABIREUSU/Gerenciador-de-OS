package model;

import java.sql.*;
import java.util.*;

public class TelaConsultaDAO {

    private Connection conn;

    public TelaConsultaDAO() {
        this.conn = Conexao.conectar();
    }

    public List<Object[]> consultarEmpresas(String filtro) {
        List<Object[]> lista = new ArrayList<>();
        String sql = "SELECT * FROM Empresas WHERE Nome LIKE ? OR CNPJ LIKE ?";

        try (PreparedStatement stmt = conn.prepareStatement(sql)) {
            stmt.setString(1, "%" + filtro + "%");
            stmt.setString(2, "%" + filtro + "%");
            ResultSet rs = stmt.executeQuery();

            while (rs.next()) {
                lista.add(new Object[]{
                        rs.getInt("Cod_Emp"),
                        rs.getString("Nome"),
                        rs.getString("CNPJ"),
                        rs.getString("Endereco"),
                        rs.getString("Telefone")
                });
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }

        return lista;
    }

    public List<Object[]> consultarEquipamentos(String filtro) {
        List<Object[]> lista = new ArrayList<>();
        String sql = "SELECT * FROM Equipamento WHERE Nome_Equip LIKE ? OR Cod_Emp LIKE ?";

        try (PreparedStatement stmt = conn.prepareStatement(sql)) {
            stmt.setString(1, "%" + filtro + "%");
            stmt.setString(2, "%" + filtro + "%");
            ResultSet rs = stmt.executeQuery();

            while (rs.next()) {
                lista.add(new Object[]{
                        rs.getInt("Cod_Equip"),
                        rs.getInt("Cod_Emp"),
                        rs.getString("Nome_Equip")
                });
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }

        return lista;
    }

    public List<Object[]> consultarOS(String filtro) {
        List<Object[]> lista = new ArrayList<>();
        String sql = "SELECT * FROM OS WHERE Data LIKE ? OR Cod_Equip LIKE ?";

        try (PreparedStatement stmt = conn.prepareStatement(sql)) {
            stmt.setString(1, "%" + filtro + "%");
            stmt.setString(2, "%" + filtro + "%");
            ResultSet rs = stmt.executeQuery();

            while (rs.next()) {
                lista.add(new Object[]{
                        rs.getInt("Cod_OS"),
                        rs.getInt("Cod_Equip"),
                        rs.getString("Data"),
                        rs.getBigDecimal("Preco")
                });
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }

        return lista;
    }
}
