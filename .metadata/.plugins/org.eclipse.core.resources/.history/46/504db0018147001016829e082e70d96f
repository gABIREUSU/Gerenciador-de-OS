package model;

import java.sql.*;
import java.util.*;

public class TelaConsultaDAO {

    public List<String> consultarEmpresas(String filtro) {
    	Conexao.conectar();
        List<String> lista = new ArrayList<>();
        String sql = "SELECT * FROM Empresas WHERE Nome LIKE ? OR CNPJ LIKE ?";

        try (Connection conn = Conexao.Conexao;
        	PreparedStatement stmt = conn.prepareStatement(sql)) {
            stmt.setString(1, "%" + filtro + "%");
            stmt.setString(2, "%" + filtro + "%");
            ResultSet rs = stmt.executeQuery();

            while (rs.next()) {
                lista.add("Código: " + rs.getInt("Cod_Emp")
                        + ", Nome: " + rs.getString("Nome")
                        + ", CNPJ: " + rs.getString("CNPJ")
                        + ", Endereço: " + rs.getString("Endereco")
                        + ", Telefone: " + rs.getString("Telefone"));
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }

        return lista;
    }

