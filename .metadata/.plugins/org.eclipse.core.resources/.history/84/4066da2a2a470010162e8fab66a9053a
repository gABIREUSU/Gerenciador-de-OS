	public int getCodEmp(String empresa) {
	    Conexao.conectar();
	    String sql = "SELECT eq.Cod_Emp FROM Equipamento eq INNER JOIN Empresas ep ON eq.Cod_Emp = ep.Cod_Emp WHERE ep.Nome = ? GROUP BY eq.Cod_Emp";

	    try (Connection conn = Conexao.Conexao;
	         PreparedStatement stmt = conn.prepareStatement(sql)) {

	        stmt.setString(1, empresa);
	        ResultSet rs = stmt.executeQuery();

	        if (rs.next()) {
	            return rs.getInt("Cod_Emp");
	        }

	    } catch (SQLException e) {
	        e.printStackTrace();
	    }
	    return -1;
	}
	
	public int getCodEquip(String equipamento,String empresa) {
	    Conexao.conectar();
	    String sql = "SELECT eq.Cod_Equip FROM Equipamento eq INNER JOIN Empresas ep ON eq.Cod_Emp = ep.Cod_Emp WHERE ep.Cod_Emp = ? AND Nome_Equip = ?";

	    try (Connection conn = Conexao.Conexao;
	         PreparedStatement stmt = conn.prepareStatement(sql)) {
	    	
	    	stmt.setInt(1, getCodEmp(empresa));
	        stmt.setString(2, equipamento);
	        ResultSet rs = stmt.executeQuery();

	        if (rs.next()) {
	            return rs.getInt("Cod_Equip");
	        }

	    } catch (SQLException e) {
	        e.printStackTrace();
	    }
	    return -1;
	}
	
	public float setPreco(List<String> lista) {
	    if (lista == null || lista.isEmpty()) return 0f;

	    Map<String, Integer> contagem = new HashMap<>();
	    for (String desc : lista) {
	        contagem.put(desc, contagem.getOrDefault(desc, 0) + 1);
	    }

	    Conexao.conectar();

	    // Monta a query para buscar preço só uma vez por item
	    String sql = "SELECT Descricao, Preco FROM Item WHERE Descricao IN (" + createInParameters(contagem.size()) + ");";

	    float somaTotal = 0f;

	    try (Connection conn = Conexao.Conexao;
	         PreparedStatement stmt = conn.prepareStatement(sql)) {

	        int index = 1;
	        for (String key : contagem.keySet()) {
	            stmt.setString(index++, key);
	        }

	        ResultSet rs = stmt.executeQuery();

	        while (rs.next()) {
	            String descricao = rs.getString("Descricao");
	            float preco = rs.getFloat("Preco");
	            int quantidade = contagem.getOrDefault(descricao, 0);
	            somaTotal += preco * quantidade;
	        }

	    } catch (SQLException e) {
	        e.printStackTrace();
	        return -1f;
	    }

	    return somaTotal;
	}
	
